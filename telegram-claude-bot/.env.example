# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Кто может пользоваться ботом: Telegram user id через запятую.
# Свой id можно узнать у @userinfobot
ALLOWED_USER_IDS=233045371

# Авторизация Claude — нужен ОДИН из двух вариантов:
# 1) OAuth-токен подписки Claude (Pro/Max): на машине с установленным
#    Claude Code выполни `claude setup-token` и вставь результат сюда.
CLAUDE_CODE_OAUTH_TOKEN=
# 2) Либо API-ключ Anthropic (платится за токены отдельно от подписки).
# ANTHROPIC_API_KEY=

# Модель (по умолчанию claude-opus-5; можно sonnet/haiku для экономии)
CLAUDE_MODEL=claude-opus-5

# Модель whisper для голосовых: tiny / base / small / medium / large-v3.
# small — хороший баланс качества и скорости на CPU для русского.
WHISPER_MODEL=small
